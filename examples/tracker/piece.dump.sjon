; A tracker piece — the native document `piece.it` is built from.
;
; Everything here is NATIVE: the content lives in this document and no
; file is read to load it. `tempura build … --kind it` renders it into
; `piece.it`, attaching both IT carriers; `tempura dump piece.it` gives
; `piece.dump.sjon`, a document that anchors those bytes INLINE and whose
; timeline tier is this one form for form. The two commands and the round
; trip are in `README.md` beside this file.
;
; Read it as the module the renderer has to produce. Speed 6 and 24 IT
; ticks to the quarter make a row a sixteenth, so a 64-row pattern is
; four bars of [4 4] and this whole piece is one pattern. A cell holds
; one note, so the three-note chord takes three channels. The tempo step
; at bar 2 is a `Txx` at its row. The curve lane writes the volume
; column, and the query lane is something a `.it` cannot hold at all.
;
; The meter stays [4 4] on purpose: a meter whose bar does not divide 64
; rows is a known gap in the renderer's pattern sizing (render_it fixes a
; pattern at 64 rows), filed and dated in docs/plans/11 rather than
; papered over here.
(timeline :title "impulse-lab" :length 4bar :end loop)
(tempo-point :at 0bar :qpm 125)
; the document conducts itself
(tempo-point :at 2bar :qpm 140)
; a Txx at row 32
(meter-point :at 0bar :sig [4 4])
(section :name a :at 0bar :dur 2bar)
; → an order comment in the residue
(section :name b :at 2bar :dur 2bar)
(cue :name "fill" :at 3bar)
(lane
  :name bass
  :kind notes
  :target bass
  (note :at 0bar :dur 1q :key 36 :vel 127)
  (note :at 1b :dur 0.5q :key 36 :vel 96)
  (note :at 2b :dur 1q :key 38 :vel 112)
  (note :at 2bar :dur 1q :key 36 :vel 127)
  (clip :at 3bar :phrase fill :repeat 1))
; the phrase below, once
(lane
  :name chord
  :kind notes
  :target chord
  (note :at 0bar :dur 2q :key 60 :vel 100)
  ; three cells, three channels
  (note :at 0bar :dur 2q :key 64 :vel 88)
  (note :at 0bar :dur 2q :key 67 :vel 76))
(lane
  :name sweep
  :kind curve
  :target sweep
  :range [0 1]
  (keyframe :at 0bar :value 0)
  (keyframe :at 2bar :value 1 :ease linear)
  ; sampled into the volume column
  (keyframe :at 4bar :value 0 :ease out-quad))
; steps there, restored from the essence
(lane
  :name hats
  :kind query
  :target hats
  :query (euclid 5 8 1))
; a .it holds no query: residue only
(phrase
  :name fill
  :length 1bar
  (lane
    :name bass
    (note :at 0q :dur 0.25q :key 38 :vel 100)
    (note :at 0.5q :dur 0.25q :key 38 :vel 80)
    (note :at 1q :dur 0.25q :key 40 :vel 90)))
; pacer's compose-mode declarations, one per target this document drives,
; so `tempura export-score piece.sjon` is compose-clean on its own.
(target :name bass :arity 4)
(target :name chord :arity 4)
(target :name sweep :arity 1)
(target :name hats :arity 1)
(anchor :id song :kind it :file "piece.it" :size 6649 :sha256 "eb2e82a5099b799d44fbf4483362cbf68bcf991c9b87c6cd4c5f759055aea940")
(it/module :title "impulse-lab"
  (it/timing :speed 6 :tempo 125 :highlight [4 16])
  (it/options :instruments false)
  (it/orders 0 1 end)
  (it/message ";; tempura\n(timeline :title \"impulse-lab\" :length 4bar :end loop)\n(section :name a :at 0bar :dur 2bar)\n(section :name b :at 2bar :dur 2bar)\n(cue :name \"fill\" :at 3bar)\n(lane :name bass :kind notes)\n(lane :name chord :kind notes)\n(lane :name sweep :kind curve :range [0 1])\n(lane :name hats :kind query :query (euclid 5 8 1))\n")
  (it/pattern 0 :rows 64
    (row 0 (ev 1 "C-3" :ins 1 :vol 64) (ev 2 "C-5" :ins 1 :vol 50) (ev 3 "E-5" :ins 1 :vol 44) (ev 4 "G-5" :ins 1 :vol 38) (ev 5 :vol 0))
    (row 1 (ev 5 :vol 2))
    (row 2 (ev 5 :vol 4))
    (row 3 (ev 5 :vol 6))
    (row 4 (ev 1 "C-3" :ins 1 :vol 48) (ev 5 :vol 8))
    (row 5 (ev 5 :vol 10))
    (row 6 (ev 1 cut) (ev 5 :vol 12))
    (row 7 (ev 5 :vol 14))
    (row 8 (ev 1 "D-3" :ins 1 :vol 56) (ev 2 cut) (ev 3 cut) (ev 4 cut) (ev 5 :vol 16))
    (row 9 (ev 5 :vol 18))
    (row 10 (ev 5 :vol 20))
    (row 11 (ev 5 :vol 22))
    (row 12 (ev 1 cut) (ev 5 :vol 24))
    (row 13 (ev 5 :vol 26))
    (row 14 (ev 5 :vol 28))
    (row 15 (ev 5 :vol 30))
    (row 16 (ev 5 :vol 32))
    (row 17 (ev 5 :vol 34))
    (row 18 (ev 5 :vol 36))
    (row 19 (ev 5 :vol 38))
    (row 20 (ev 5 :vol 40))
    (row 21 (ev 5 :vol 42))
    (row 22 (ev 5 :vol 44))
    (row 23 (ev 5 :vol 46))
    (row 24 (ev 5 :vol 48))
    (row 25 (ev 5 :vol 50))
    (row 26 (ev 5 :vol 52))
    (row 27 (ev 5 :vol 54))
    (row 28 (ev 5 :vol 56))
    (row 29 (ev 5 :vol 58))
    (row 30 (ev 5 :vol 60))
    (row 31 (ev 5 :vol 62))
    (row 32 (ev 1 "C-3" :ins 1 :vol 64 :fx "T8C") (ev 5 :vol 64))
    (row 36 (ev 1 cut))
    (row 48 (ev 1 "D-3" :ins 1 :vol 50))
    (row 49 (ev 1 cut))
    (row 50 (ev 1 "D-3" :ins 1 :vol 40))
    (row 51 (ev 1 cut))
    (row 52 (ev 1 "E-3" :ins 1 :vol 45))
    (row 53 (ev 1 cut)))
  (it/pattern 1 :rows 64
    (row 0 (ev 5 :vol 0))))
