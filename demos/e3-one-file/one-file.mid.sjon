; E3's document: one file holds everything.
;
; A native timeline with two sections and a cue, a notes lane, a curve
; lane whose middle keyframe eases with a SPRING, and a query lane. Three
; of those four things a `.mid` and a `.it` cannot say, and all three ride
; in the file's own metadata slots. `README.md` beside this file walks the
; whole round trip and then breaks it on purpose.
(timeline :title "one-file" :length 4bar :end loop)
(tempo-point :at 0bar :qpm 110)
(meter-point :at 0bar :sig [4 4])
(section :name rise :at 0bar :dur 2bar)
(section :name fall :at 2bar :dur 2bar)
(cue :name "turn" :at 2bar)
(lane
  :name snare
  :kind notes
  :target snare
  (note :at 1b :dur 0.5q :key 38 :vel 100)
  (note :at 3b :dur 0.5q :key 38 :vel 84)
  (note :at 5b :dur 0.5q :key 38 :vel 100)
  (note :at 7b :dur 0.5q :key 38 :vel 84)
  (note :at 9b :dur 0.5q :key 38 :vel 100)
  (note :at 11b :dur 0.5q :key 38 :vel 84)
  (note :at 13b :dur 0.5q :key 38 :vel 100)
  (note :at 15b :dur 0.5q :key 38 :vel 120))
(lane
  :name bloom
  :kind curve
  :target bloom
  :range [0 1]
  (keyframe :at 0bar :value 0)
  (keyframe :at 1bar :value 1 :ease (spring :damping 0.35))
  (keyframe :at 3bar :value 0.2 :ease linear)
  (keyframe :at 4bar :value 0 :ease hold))
(lane
  :name grit
  :kind query
  :target grit
  :query (euclid 7 16 2))
; pacer's compose-mode declarations, so the exported score is
; compose-clean on its own.
(target :name snare :arity 4)
(target :name bloom :arity 1)
(target :name grit :arity 1)
(anchor :id song :kind smf :file "one-file.mid" :size 4170 :sha256 "ae96d3eb0cc7f534ee1e5ff3ba7de9e1ffc1a2b49cbd3d1402121a66d3409cb3")
(midi/smf :format 1 :division 960)

(midi/mtrk
  (time-signature :at 0 :num 4 :denom 4 :clocks 24 :thirty-seconds 8)
  (set-tempo :at 0 :us 545455)
  (marker :at 7680 :text "turn")
  (end-of-track :at 7680))

(midi/mtrk
  (sequence-name :at 0 :text "snare")
  (note-on :at 960 :ch 1 :key 38 :vel 100)
  (note-off :at 1440 :ch 1 :key 38 :vel 64)
  (note-on :at 2880 :ch 1 :key 38 :vel 84)
  (note-off :at 3360 :ch 1 :key 38 :vel 64)
  (note-on :at 4800 :ch 1 :key 38 :vel 100)
  (note-off :at 5280 :ch 1 :key 38 :vel 64)
  (note-on :at 6720 :ch 1 :key 38 :vel 84)
  (note-off :at 7200 :ch 1 :key 38 :vel 64)
  (note-on :at 8640 :ch 1 :key 38 :vel 100)
  (note-off :at 9120 :ch 1 :key 38 :vel 64)
  (note-on :at 10560 :ch 1 :key 38 :vel 84)
  (note-off :at 11040 :ch 1 :key 38 :vel 64)
  (note-on :at 12480 :ch 1 :key 38 :vel 100)
  (note-off :at 12960 :ch 1 :key 38 :vel 64)
  (note-on :at 14400 :ch 1 :key 38 :vel 120)
  (note-off :at 14880 :ch 1 :key 38 :vel 64)
  (end-of-track :at 14880))

(midi/mtrk
  (sequence-name :at 0 :text "bloom")
  (control-change :at 0 :ch 1 :num 11 :val 0)
  (control-change :at 3840 :ch 1 :num 11 :val 127)
  (control-change :at 3960 :ch 1 :num 11 :val 125)
