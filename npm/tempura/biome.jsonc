{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  // Lint + format for the JS+JSDoc glue, pacer's configuration verbatim. Scoped to
  // src/, test/ and the dev-only build scripts; the generated types/ and the wasm
  // binary are left alone.
  // quoteStyle is single to formalize the existing source idiom (not Biome's
  // double-quote default). Recommended rules are on by default.
  "files": {
    "includes": ["src/**/*.js", "test/**/*.js", "scripts/**/*.mjs"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "noNonNullAssertion": "error",
        "useNodejsImportProtocol": "error",
        "useImportType": "error"
      },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
