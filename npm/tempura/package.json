{
  "name": "tempura",
  "version": "0.1.0",
  "type": "module",
  "description": "JS glue for tempura.wasm — the timeline as a value: SJON documents, .mid and .it",
  "keywords": [
    "tempura",
    "pacer",
    "sjon",
    "timeline",
    "midi",
    "impulse-tracker",
    "deterministic",
    "wasm",
    "webassembly"
  ],
  "author": "Hugo Daniel <mail@hugodaniel.pt>",
  "license": "CC0-1.0",
  "homepage": "https://github.com/HugoDaniel/tempura#readme",
  "bugs": {
    "url": "https://github.com/HugoDaniel/tempura/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoDaniel/tempura.git",
    "directory": "npm/tempura"
  },
  "publishConfig": {
    "registry": "https://git.hugodaniel.com/api/packages/hugo/npm/"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./ops": {
      "types": "./types/ops.d.ts",
      "default": "./src/ops.js"
    },
    "./blobs": {
      "types": "./types/blobs.d.ts",
      "default": "./src/blobs.js"
    },
    "./tempura.wasm": "./tempura.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "tempura.wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:fixtures": "cd ../.. && tools/zt landing",
    "build:wasm": "cd ../.. && tools/zt wasm",
    "build:sjon-wasm": "cd ../.. && tools/zt sjon-wasm",
    "build:pacer-wasm": "node scripts/build-pacer-wasm.mjs",
    "build:types": "tsc",
    "build": "npm run build:wasm && npm run build:types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts",
    "format": "biome check --write src test scripts",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('types',{recursive:true,force:true});fs.rmSync('tempura.wasm',{force:true})\"",
    "pretest": "npm run build:wasm && npm run build:fixtures && npm run build:sjon-wasm && npm run build:pacer-wasm",
    "test": "node --test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "pacer": "file:../../../pacer/npm/pacer",
    "typescript": "^5.9.0"
  }
}
